# ============================================
# Clockodo MCP Server - Environment Variables
# ============================================

# Clockodo API Credentials
CLOCKODO_API_USER=your@email.com
CLOCKODO_API_KEY=your_api_key
CLOCKODO_USER_AGENT=clockodo-mcp/0.1.0
CLOCKODO_BASE_URL=https://my.clockodo.com/api/
CLOCKODO_EXTERNAL_APP_CONTACT=your@email.com

# ============================================
# Feature Configuration
# ============================================
# IMPORTANT: When using MCP clients (Claude Desktop, IDEs),
# set these in the MCP configuration JSON's "env" object.
# This .env file is for local development/testing only.
# ============================================

# Role-based configuration (recommended):
# CLOCKODO_MCP_ROLE=employee       # Track your own time (default when unset)
# CLOCKODO_MCP_ROLE=team_leader    # Employee + approve vacations & edit team entries
# CLOCKODO_MCP_ROLE=hr_analytics   # View HR compliance reports only
# CLOCKODO_MCP_ROLE=admin          # Full access to everything

# Transport configuration:
# CLOCKODO_MCP_TRANSPORT=stdio     # stdin/stdout for local processes (default)
# CLOCKODO_MCP_TRANSPORT=sse       # HTTP/SSE for remote access
# CLOCKODO_MCP_HOST=127.0.0.1      # Host to bind to (default: 127.0.0.1; 0.0.0.0 in Docker)
# CLOCKODO_MCP_PORT=8000           # Port for SSE transport (default: 8000)
# CLOCKODO_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*  # Host header allow-list
# CLOCKODO_MCP_AUTH_TOKEN=         # Bearer token; required when host is not loopback

# Time zone for times without an offset (default: Europe/Zurich)
# CLOCKODO_TIMEZONE=Europe/Zurich

# ============================================
# Manual Testing Configuration
# ============================================
# Used in manual-test/test_clockodo.ipynb
# TEST_TEAM_MEMBER_ID=123456
