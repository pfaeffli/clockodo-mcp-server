# Trivy ignore file for known false positives and acceptable risks
# These are base OS package vulnerabilities that don't affect our Python application

# util-linux vulnerabilities - we don't use setpwnam, chfn, chsh in containerized Python app
CVE-2024-28085  # Heap buffer overread in setpwnam() - not exploitable in container
CVE-2022-0563   # chfn/chsh with libreadline - not used
CVE-2001-1494   # libuuid - extremely old, not exploitable

# tar vulnerabilities - we don't use tar at runtime
CVE-2005-2541   # rmt command side effects - tar not used in runtime
CVE-2022-48303  # setuid/setgid warning - not applicable

# sysvinit/shadow-utils - not relevant for containerized app
CVE-2007-5686   # sysvinit expert installer - not used
CVE-2013-4235   # shadow-utils login.defs - not applicable in container

# ncurses - we don't use terminal manipulation
CVE-2023-50495  # ncurses stack overflow - Python doesn't expose this
CVE-2023-45918  # ncurses stack overflow - Python doesn't expose this

# perl - not used at runtime
CVE-2023-31484  # File::Temp - Perl not in runtime image

# Other low severity issues
CVE-2005-4890   # Old shadow-utils issue - not applicable
CVE-2007-5191   # initscripts permissions - not relevant in container

# sqlite3 - Medium severity but requires FTS5 specific usage
CVE-2024-0232   # FTS5 integer overflow - we don't use FTS5 features

# ---------------------------------------------------------------------------
# Dated waivers. Every entry below is a base-image (Debian) package finding
# with NO fixed version available upstream. Re-verified 2026-09-20 against a
# freshly built image (python:3.13-slim, Debian 13.7) with:
#   docker save clockodo-mcp:latest -o img.tar
#   trivy image --input img.tar --severity UNKNOWN,LOW,MEDIUM,HIGH,CRITICAL
# Entries whose CVE is no longer reported at any severity are deleted rather
# than extended (see the PR for the list dropped on 2026-09-20).
# ---------------------------------------------------------------------------

# ncurses buffer overflow — affects libncursesw6, libtinfo6, ncurses-base,
# ncurses-bin. Still no fix in Debian trixie as of 2026-09 (status: affected).
# The overflow is in analyze_string() in the `infocmp` command-line tool,
# which this server never invokes; it runs `clockodo-mcp` with no terminfo
# tooling in the runtime path.
# Re-evaluate by 2026-11-15.
CVE-2025-69720 exp:2026-11-15

# perl-base — Archive::Tar denial of service via a crafted tar header
# declaring a multi-gigabyte entry size. No fix in Debian trixie as of
# 2026-09 (status: fix_deferred, perl-base 5.40.1-6+deb13u1). perl-base is a
# base-image essential package (dpkg depends on it) and is never invoked by
# this server, which performs no tar or archive processing at runtime.
# Re-evaluate by 2026-11-15.
CVE-2026-9538 exp:2026-11-15    # perl-Archive-Tar DoS (HIGH)

# acl / attr symlink-traversal privilege escalation — affects libacl1 and
# libattr1. No fix in Debian trixie as of 2026-09 (status: affected). The
# escalation requires a privileged process walking attacker-controlled
# symlinks through the libacl pathname functions; this image runs as the
# non-root `appuser` (Dockerfile:57) and performs no acl/xattr operations.
# Re-evaluate by 2026-11-15.
CVE-2026-54369 exp:2026-11-15   # libacl1 symlink traversal (HIGH)
CVE-2026-54371 exp:2026-11-15   # libattr1 symlink traversal (MEDIUM)

# systemd-homed local privilege escalation via missing home-record signature
# verification — Trivy attributes this to libsystemd0 / libudev1, the only
# systemd components present. No fix in Debian trixie as of 2026-09 (status:
# affected, 257.13-1~deb13u1). systemd-homed itself is not installed, no
# systemd process runs in this container, and there are no homed-managed
# users, so the vulnerable code is absent rather than merely unreachable.
# Re-evaluate by 2026-11-15.
CVE-2026-16742 exp:2026-11-15   # systemd-homed LPE (HIGH)

# util-linux mount(8) / nsenter privilege escalation — affects util-linux,
# mount, bsdutils, libblkid1, libmount1, libuuid1, libsmartcols1,
# liblastlog2-2 (all HIGH). No fix in Debian trixie as of 2026-09 (status:
# affected, 2.41.5-0+deb13u1); upstream util-linux is affected through
# 2.41.5 / 2.42.2. Every one of these requires a local unprivileged user
# invoking SUID mount(8) or nsenter against an fstab-authorized entry. This
# container ships no fstab entries, mounts no volumes at runtime, never
# invokes mount/nsenter, and runs as the non-root `appuser`.
# Re-evaluate by 2026-11-15.
CVE-2026-76642 exp:2026-11-15   # X-mount post-hooks run after helper failure
CVE-2026-78408 exp:2026-11-15   # nsenter --join-cgroup leaks root authority
CVE-2026-78409 exp:2026-11-15   # X-mount.subdir symlink escape
CVE-2026-78410 exp:2026-11-15   # restricted bind mounts do not pin source
