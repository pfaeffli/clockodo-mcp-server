# Live QA suite configuration. Copy to manual-test/.env.live and fill in.
#
# !!! WARNING !!!
# The live suite WRITES and DELETES time entries and absences. NEVER point it
# at a production company. Use a Clockodo trial company only.
#
# Trial company setup (https://www.clockodo.com, free trial):
#   1. Register a trial company; the first user is the admin (this is the
#      user whose API credentials you use below).
#   2. Create ONE extra employee user (default name "Demo Employee").
#   3. Create a team; make the admin its team leader and the employee a member.
#   4. Create a customer (default "Demo Customer") and a service
#      (default "Demo Service").
#   5. Admin user -> personal settings -> copy the API key.

CLOCKODO_API_USER=admin@example.invalid
CLOCKODO_API_KEY=replace-with-api-key
CLOCKODO_BASE_URL=https://my.clockodo.com/api

# Optional: names to look up (defaults shown)
# LIVE_CUSTOMER=Demo Customer
# LIVE_SERVICE=Demo Service
# LIVE_EMPLOYEE=Demo Employee

# Optional: a Monday (YYYY-MM-DD) as base for test dates (default 2026-10-12)
# LIVE_WEEK=2026-10-12

# Optional: zone for naive times (default Europe/Zurich)
# CLOCKODO_TIMEZONE=Europe/Zurich
